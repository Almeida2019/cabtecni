# Copy this file to `.env.local` and fill in the value.
# `.env.local` is already in .gitignore via the `.env*` pattern — do NOT
# commit the real key.

# kie.ai API key. Manage at https://kie.ai (top-right, "API").
KIE_API_KEY=

# OpenRouter API key for the site chatbot. Create one at
# https://openrouter.ai/keys  (the default model below is free).
# Leave blank to disable the assistant (the widget then reports it is not configured).
OPENROUTER_API_KEY=

# Optional. Defaults to poolside/laguna-s-2.1:free
# Any OpenRouter model id works, so switching providers is a one-line change.
OPENROUTER_MODEL=

# Optional attribution shown on OpenRouter's public rankings.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
